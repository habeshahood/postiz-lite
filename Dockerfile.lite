# postiz-lite: Fork of the official Postiz Dockerfile.
# Replaces NestJS backend + Temporal with a single Go binary.
# Same nginx/pm2/Next.js frontend setup — drop-in replacement.
#
# Build:  docker build -t postiz-lite -f Dockerfile.lite .
# Run:    docker run -p 127.0.0.1:5001:5000 --env-file .env.lite postiz-lite

# ── Stage 1: Build Go backend ──────────────────────────────────
FROM golang:1.24-alpine AS go-builder
WORKDIR /build
COPY go-backend/go.mod go-backend/go.sum ./
RUN go mod download
COPY go-backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /postiz-lite ./cmd/postiz-lite/

# ── Stage 2: Build frontend (same as official Dockerfile) ──────
FROM node:22.20-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make python3-pip bash nginx curl \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app
COPY . /app

# Copy the Go binary
COPY --from=go-builder /postiz-lite /usr/local/bin/postiz-lite

# nginx config (same as official — routes /api/ to :3000, / to :4200)
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# Install dependencies and build frontend
RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Override PM2 ecosystem: replace NestJS backend + orchestrator with Go binary
# The Go binary listens on port 3000 (where nginx expects the backend)
# The frontend runs on port 4200 (unchanged)
RUN cat > /app/ecosystem.config.js <<'PM2'
module.exports = {
  apps: [
    {
      name: "go-backend",
      script: "/usr/local/bin/postiz-lite",
      env: {
        PORT: "3000",
        BIND_ADDR: "0.0.0.0",
        TENANTS_FILE: "/config/tenants.json",
      },
    },
    {
      name: "frontend",
      cwd: "/app/apps/frontend",
      script: "pnpm",
      args: "start",
      env: {
        PORT: "4200",
        NEXT_TELEMETRY_DISABLED: "1",
      },
    },
  ],
};
PM2

# Upload directory
RUN mkdir -p /uploads /config
VOLUME /uploads /config

EXPOSE 5000

# Start nginx + pm2 (same as official, but using our ecosystem config)
CMD ["sh", "-c", "nginx && pm2 start ecosystem.config.js && pm2 logs"]
