# postiz-lite: Optimized multi-stage build.
# Go backend + Next.js frontend + nginx. Drop-in replacement for stock Postiz.
#
# Build:  docker build -t postiz-lite -f Dockerfile.lite .
# Size:   ~1GB (down from ~10GB)

# ── Stage 1: Build Go backend ──────────────────────────────────
FROM golang:1.24-alpine AS go-builder
WORKDIR /build
COPY go-backend/go.mod go-backend/go.sum ./
RUN go mod download
COPY go-backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /postiz-lite ./cmd/postiz-lite/

# ── Stage 2: Build frontend ────────────────────────────────────
FROM node:22.20-bookworm-slim AS frontend-builder
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1
WORKDIR /app
# Copy package files first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/frontend/package.json apps/frontend/
COPY apps/backend/package.json apps/backend/
COPY apps/orchestrator/package.json apps/orchestrator/
COPY apps/cli/package.json apps/cli/
COPY apps/sdk/package.json apps/sdk/
COPY apps/workers/package.json apps/workers/
COPY libraries/nestjs-libraries/package.json libraries/nestjs-libraries/
COPY libraries/react-shared-libraries/package.json libraries/react-shared-libraries/
COPY libraries/helpers/package.json libraries/helpers/
RUN pnpm install --frozen-lockfile 2>/dev/null || pnpm install
# Copy source and build
COPY . .
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# ── Stage 3: Production runtime (lean) ─────────────────────────
FROM node:22.20-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash nginx curl \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pm2

WORKDIR /app

# Copy ONLY production artifacts from builder
COPY --from=go-builder /postiz-lite /usr/local/bin/postiz-lite
COPY --from=frontend-builder /app/apps/frontend/.next /app/apps/frontend/.next
COPY --from=frontend-builder /app/apps/frontend/public /app/apps/frontend/public
COPY --from=frontend-builder /app/apps/frontend/package.json /app/apps/frontend/
COPY --from=frontend-builder /app/apps/frontend/node_modules /app/apps/frontend/node_modules
COPY --from=frontend-builder /app/node_modules /app/node_modules
COPY --from=frontend-builder /app/package.json /app/
COPY --from=frontend-builder /app/.env /app/.env 2>/dev/null || true

# nginx config
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# PM2 ecosystem
RUN cat > /app/ecosystem.config.js <<'PM2'
module.exports = {
  apps: [
    {
      name: "go-backend",
      script: "/usr/local/bin/postiz-lite",
      env: {
        PORT: "3000",
        BIND_ADDR: "0.0.0.0",
        TENANTS_FILE: "/config/tenants.json",
      },
    },
    {
      name: "frontend",
      cwd: "/app/apps/frontend",
      script: "node_modules/.bin/next",
      args: "start -p 4200",
      env: {
        PORT: "4200",
        NEXT_TELEMETRY_DISABLED: "1",
      },
    },
  ],
};
PM2

RUN mkdir -p /uploads /config
VOLUME /uploads /config

EXPOSE 5000

CMD ["sh", "-c", "nginx && pm2 start ecosystem.config.js && pm2 logs"]
