# postiz-lite: Go backend + Next.js frontend + nginx.
# Drop-in replacement for stock Postiz (NestJS + Temporal).
#
# Build:  docker build -t postiz-lite -f Dockerfile.lite .

# ── Stage 1: Build Go backend ──────────────────────────────────
FROM golang:1.24-alpine AS go-builder
WORKDIR /build
COPY go-backend/go.mod go-backend/go.sum ./
RUN go mod download
COPY go-backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /postiz-lite ./cmd/postiz-lite/

# ── Stage 2: Build frontend + produce runtime ──────────────────
FROM node:22.20-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make python3-pip bash nginx curl \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app
COPY . /app
COPY --from=go-builder /postiz-lite /usr/local/bin/postiz-lite
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# Install and build
RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# ── Cleanup: remove build artifacts to shrink image ────────────
RUN rm -rf /root/.local/share/pnpm \
    /root/.npm \
    /root/.cache \
    /app/apps/backend \
    /app/apps/orchestrator \
    /app/apps/cli \
    /app/apps/commands \
    /app/apps/extension \
    /app/apps/sdk \
    /app/go-backend \
    /tmp/* \
 && pnpm prune --prod 2>/dev/null || true \
 && find /app/node_modules -name "*.d.ts" -delete 2>/dev/null \
 && find /app/node_modules -name "*.map" -delete 2>/dev/null \
 && find /app/node_modules -name "*.md" -delete 2>/dev/null

# PM2 ecosystem
RUN cat > /app/ecosystem.config.js <<'PM2'
module.exports = {
  apps: [
    {
      name: "go-backend",
      script: "/usr/local/bin/postiz-lite",
      env: {
        PORT: "3000",
        BIND_ADDR: "0.0.0.0",
        TENANTS_FILE: "/config/tenants.json",
      },
    },
    {
      name: "frontend",
      cwd: "/app/apps/frontend",
      script: "pnpm",
      args: "start",
      env: {
        PORT: "4200",
        NEXT_TELEMETRY_DISABLED: "1",
      },
    },
  ],
};
PM2

RUN mkdir -p /uploads /config
VOLUME /uploads /config

EXPOSE 5000

CMD ["sh", "-c", "nginx && pm2 start ecosystem.config.js && pm2 logs"]
