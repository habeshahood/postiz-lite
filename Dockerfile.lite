# postiz-lite: Drop-in replacement for ghcr.io/gitroomhq/postiz-app
# Go backend + Next.js frontend, single port 5000.
#
# Build:  docker build -t postiz-lite -f Dockerfile.lite .
# Run:    docker run -p 127.0.0.1:5001:5000 --env-file .env.lite postiz-lite

# ── Stage 1: Build Go backend ──────────────────────────────────
FROM golang:1.24-alpine AS go-builder
WORKDIR /build
COPY go-backend/go.mod go-backend/go.sum ./
RUN go mod download
COPY go-backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /postiz-lite ./cmd/postiz-lite/

# ── Stage 2: Build Next.js frontend ───────────────────────────
FROM node:20-alpine AS frontend-builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Copy entire monorepo for pnpm workspace resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json tsconfig.json ./
COPY i18n.json i18n.lock ./
COPY apps/ apps/
COPY libraries/ libraries/

RUN pnpm install --frozen-lockfile --ignore-scripts 2>/dev/null || pnpm install --no-frozen-lockfile

# Build frontend with placeholder backend URL (replaced at runtime)
ENV NEXT_PUBLIC_BACKEND_URL=BACKEND_PLACEHOLDER
ENV BACKEND_INTERNAL_URL=http://localhost:5000
ENV NEXT_TELEMETRY_DISABLED=1
ENV STORAGE_PROVIDER=local
ENV NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

RUN cd apps/frontend && npx next build 2>&1 || true

# ── Stage 3: Runtime ──────────────────────────────────────────
FROM node:20-alpine AS runtime

RUN apk add --no-cache ca-certificates tzdata supervisor

# Go binary
COPY --from=go-builder /postiz-lite /usr/local/bin/postiz-lite

# Next.js built output + node_modules for SSR
COPY --from=frontend-builder /app/apps/frontend/.next /app/apps/frontend/.next
COPY --from=frontend-builder /app/apps/frontend/public /app/apps/frontend/public
COPY --from=frontend-builder /app/apps/frontend/package.json /app/apps/frontend/package.json
COPY --from=frontend-builder /app/apps/frontend/next.config.js /app/apps/frontend/next.config.js
COPY --from=frontend-builder /app/node_modules /app/node_modules
COPY --from=frontend-builder /app/libraries /app/libraries
COPY --from=frontend-builder /app/apps/backend /app/apps/backend
COPY --from=frontend-builder /app/package.json /app/package.json
COPY --from=frontend-builder /app/tsconfig.base.json /app/tsconfig.base.json
COPY --from=frontend-builder /app/i18n.json /app/i18n.json

# Upload + config directories
RUN mkdir -p /uploads /config
VOLUME /uploads /config

# Supervisor config: Go backend (port 5000) + Next.js (port 4200)
RUN cat > /etc/supervisord.conf <<'SUPERVISORD'
[supervisord]
nodaemon=true
logfile=/dev/stdout
logfile_maxbytes=0
loglevel=info

[program:go-backend]
command=/usr/local/bin/postiz-lite
directory=/app
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:nextjs-frontend]
command=node_modules/.bin/next start -p 4200
directory=/app/apps/frontend
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
SUPERVISORD

# Entrypoint: replace backend URL placeholder, then start
RUN cat > /entrypoint.sh <<'ENTRY'
#!/bin/sh
set -e

# Replace backend URL placeholder in Next.js build output
if [ -n "$NEXT_PUBLIC_BACKEND_URL" ]; then
  find /app/apps/frontend/.next -type f -name '*.js' -exec \
    sed -i "s|BACKEND_PLACEHOLDER|$NEXT_PUBLIC_BACKEND_URL|g" {} + 2>/dev/null || true
fi

# Set defaults for Go backend
export BIND_ADDR="${BIND_ADDR:-0.0.0.0}"
export FRONTEND_INTERNAL_URL="${FRONTEND_INTERNAL_URL:-http://localhost:4200}"
export UPLOAD_DIR="${UPLOAD_DIR:-/uploads}"
export PORT="${PORT:-5000}"

exec /usr/bin/supervisord -c /etc/supervisord.conf
ENTRY
RUN chmod +x /entrypoint.sh

EXPOSE 5000
ENTRYPOINT ["/entrypoint.sh"]
